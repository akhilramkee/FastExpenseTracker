# Ollama API endpoint (default: local instance)
OLLAMA_URL=http://127.0.0.1:11434

# Model used for transaction enrichment
OLLAMA_MODEL=qwen3:8b

# Soft timeout: API caller returns but Ollama keeps running in background (seconds)
OLLAMA_SOFT_TIMEOUT=60

# Hard timeout: mark enrichment failed if Ollama has not responded (seconds)
OLLAMA_HARD_TIMEOUT=300
