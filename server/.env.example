# Ollama (server-side enrichment fallback and import parsing)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# OpenRouter (shared with tailnet clients for on-device enrichment)
# Generate at https://openrouter.ai/keys — must be a free model
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Soft timeout: API caller returns but enrichment keeps running in background (seconds)
ENRICHMENT_SOFT_TIMEOUT=60

# Hard timeout: mark enrichment failed if LLM has not responded (seconds)
ENRICHMENT_HARD_TIMEOUT=300
